        <mxCell id="FMxy3eZNfXnOoqkCgU_e-32" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;rounded=0;fontSize=24;fontStyle=0" value="Every resident obesrves 2&lt;div&gt;different routes how neinbours visit&lt;/div&gt;&lt;div&gt;each other.&lt;/div&gt;&lt;div&gt;All routes reported by 3 residents:&lt;/div&gt;&lt;div&gt;3 * 2 = 6, ie &lt;b&gt;3! = 6&lt;/b&gt;&lt;br&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
