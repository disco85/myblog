        </mxCell>
        <mxCell id="FMxy3eZNfXnOoqkCgU_e-33" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;rounded=0;fontSize=24;fontStyle=0" value="Resident &quot;1&quot; observes 3 neighbours,&lt;div&gt;their visit routes are already known:&lt;/div&gt;&lt;div&gt;they are 6.&lt;/div&gt;&lt;div&gt;All routes reported by 4 residents:&lt;/div&gt;&lt;div&gt;4 * 6 = 24, ie, &lt;b&gt;4! = 24&lt;/b&gt;&lt;/div&gt;" vertex="1">
